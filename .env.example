# SkillBridge — Environment Variables
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control — it contains secrets.

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="SkillBridge"
APP_VERSION="1.0.0"
# Set to false in production; true enables hot-reload, SQL echo, and debug pages.
DEBUG=false
# Options: development | production
ENVIRONMENT=production

# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default, zero-config):
DATABASE_URL=sqlite+aiosqlite:///./career_assessment.db
# PostgreSQL (recommended for production multi-worker deployments):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/skillbridge

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── SMS / OTP ───────────────────────────────────────────────────────────────
# console  — prints OTP to the terminal (development only; blocked in production)
# eskiz    — sends a real SMS via Eskiz (required in production)
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
OTP_EXPIRE_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Leave empty to use the built-in offline fallback (no AI features).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ─── CORS ────────────────────────────────────────────────────────────────────
# Update to your production domain(s) before deploying.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
